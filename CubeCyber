-- ==================== HELPERS ====================
local function isPlayerCharacter(obj)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character == obj then return true end
    end
    return false
end

local function jaCapturado(obj)
    for _, c in ipairs(capturedNPCs) do
        if c == obj then return true end
    end
    return false
end

local function removerDaLista(npc)
    for i, v in ipairs(capturedNPCs) do
        if v == npc then table.remove(capturedNPCs, i) break end
    end
end

-- ==================== CAPTURAR ====================
local function capturarNPC(npc)
    if jaCapturado(npc) then return end
    if isPlayerCharacter(npc) then return end

    local npcHRP = npc:FindFirstChild("HumanoidRootPart")
    local hum = npc:FindFirstChildOfClass("Humanoid")
    if not npcHRP or not hum then return end
    if hum.Health <= 0 then return end

    table.insert(capturedNPCs, npc)
    npcHRP.Anchored = true

    local prison = getPrisonCube()
    local ox = math.random(-40, 40)
    local oy = math.random(-40, 40)
    local oz = math.random(-40, 40)
    npcHRP.CFrame = CFrame.new(prison.Position + Vector3.new(ox, oy, oz))
end

-- ==================== AÇÕES ====================
local function killNPC(npc)
    local hum = npc:FindFirstChildOfClass("Humanoid")
    if hum then hum.Health = 0 end
    local npcHRP = npc:FindFirstChild("HumanoidRootPart")
    if npcHRP then npcHRP.Anchored = false end
    removerDaLista(npc)
end

local function soltarNPC(npc)
    local char = LocalPlayer.Character
    local npcHRP = npc:FindFirstChild("HumanoidRootPart")
    if npcHRP and char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local angle = math.random() * math.pi * 2
            npcHRP.CFrame = hrp.CFrame * CFrame.new(
                math.cos(angle) * 3, 0, math.sin(angle) * 3
            )
            npcHRP.Anchored = false
        end
    end
    removerDaLista(npc)
end

local function soltarTodos()
    -- copia para iterar sem problema
    local lista = {}
    for _, v in ipairs(capturedNPCs) do table.insert(lista, v) end
    for _, npc in ipairs(lista) do
        soltarNPC(npc)
    end
    capturedNPCs = {}
end

local function atirarNPC(npc)
    local char = LocalPlayer.Character
    local npcHRP = npc:FindFirstChild("HumanoidRootPart")
    if not npcHRP or not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local side = (math.random(0, 1) == 0) and -1 or 1
    npcHRP.Anchored = false
    npcHRP.CFrame = hrp.CFrame * CFrame.new(side * 3, 0, 0)

    local alvo = nil
    local menorDist = math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local plrHRP = plr.Character:FindFirstChild("HumanoidRootPart")
            if plrHRP then
                local d = (plrHRP.Position - hrp.Position).Magnitude
                if d < menorDist then
                    menorDist = d
                    alvo = plrHRP
                end
            end
        end
    end

    if alvo then
        local dir = (alvo.Position - npcHRP.Position).Unit
        local bv = Instance.new("BodyVelocity")
        bv.Velocity = dir * 9e9
        bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        bv.Parent = npcHRP
        game:GetService("Debris"):AddItem(bv, 0.05)
    end

    removerDaLista(npc)
end

local function despedacarNPC(npc)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    for _, joint in ipairs(npc:GetDescendants()) do
        if joint:IsA("Motor6D") or joint:IsA("Weld") or joint:IsA("WeldConstraint") then
            joint:Destroy()
        end
    end

    for _, p in ipairs(npc:GetDescendants()) do
        if p:IsA("BasePart") then
            p.Anchored = false
            p.CanCollide = true
            if hrp then
                local angle = math.random() * math.pi * 2
                local dist = math.random(2, 5)
                p.CFrame = hrp.CFrame * CFrame.new(
                    math.cos(angle) * dist, math.random(0, 3), math.sin(angle) * dist
                )
                p.Velocity = Vector3.new(
                    math.random(-20, 20), math.random(10, 30), math.random(-20, 20)
                )
            end
        end
    end

    removerDaLista(npc)
end

