local function spawnCube(char)
    if currentConnection then currentConnection:Disconnect() end
    if currentCube then currentCube:Destroy() end
    capturedNPCs = {}
    setAutoCapture(false)
    fecharPainel()

    local hrp = char:WaitForChild("HumanoidRootPart")

    local cube = Instance.new("Part")
    cube.Name = "CyberCubeFloat"
    cube.Size = Vector3.new(1, 1, 1)
    cube.Anchored = true
    cube.CanCollide = false
    cube.Material = Enum.Material.Glass
    cube.Color = Color3.fromRGB(10, 10, 10)
    cube.Transparency = 0.78
    cube.CastShadow = false
    cube.Parent = workspace
    currentCube = cube

    local hl = Instance.new("Highlight")
    hl.FillTransparency = 1
    hl.OutlineTransparency = 0
    hl.OutlineColor = Color3.fromRGB(0, 255, 255)
    hl.Parent = cube

    -- Trails originais
    local att0 = Instance.new("Attachment")
    att0.Position = Vector3.new(0, 0.5, 0)
    att0.Parent = cube
    local att1 = Instance.new("Attachment")
    att1.Position = Vector3.new(0, -0.5, 0)
    att1.Parent = cube

    local trail = Instance.new("Trail")
    trail.Attachment0 = att0
    trail.Attachment1 = att1
    trail.Lifetime = 1.2
    trail.MinLength = 0.02
    trail.FaceCamera = true
    trail.LightInfluence = 0
    trail.LightEmission = 0.15
    trail.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(0,80,80)),
        ColorSequenceKeypoint.new(0.2, Color3.fromRGB(5,15,15)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(3,3,3)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(0,0,0)),
    })
    trail.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.2),
        NumberSequenceKeypoint.new(0.3, 0.4),
        NumberSequenceKeypoint.new(0.7, 0.7),
        NumberSequenceKeypoint.new(1, 1),
    })
    trail.WidthScale = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(0.5, 0.6),
        NumberSequenceKeypoint.new(1, 0.1),
    })
    trail.Parent = cube

    local att2 = Instance.new("Attachment")
    att2.Position = Vector3.new(0, 0.25, 0)
    att2.Parent = cube
    local att3 = Instance.new("Attachment")
    att3.Position = Vector3.new(0, -0.25, 0)
    att3.Parent = cube

    local innerTrail = Instance.new("Trail")
    innerTrail.Attachment0 = att2
    innerTrail.Attachment1 = att3
    innerTrail.Lifetime = 0.8
    innerTrail.MinLength = 0.02
    innerTrail.FaceCamera = true
    innerTrail.LightInfluence = 0
    innerTrail.LightEmission = 0.4
    innerTrail.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(0,120,120)),
        ColorSequenceKeypoint.new(0.4, Color3.fromRGB(0,40,40)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(0,0,0)),
    })
    innerTrail.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.3),
        NumberSequenceKeypoint.new(0.5, 0.6),
        NumberSequenceKeypoint.new(1, 1),
    })
    innerTrail.WidthScale = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.5),
        NumberSequenceKeypoint.new(1, 0),
    })
    innerTrail.Parent = cube

    local click = Instance.new("ClickDetector")
    click.MaxActivationDistance = 20
    click.Parent = cube

    click.MouseClick:Connect(function(plr)
        if plr ~= LocalPlayer then return end

        local now = tick()
        local diff = now - lastClickTime

        if diff <= DOUBLE_CLICK_TIME then
            -- Duplo clique: toggle auto captura
            lastClickTime = 0
            setAutoCapture(not autoCapture)
            task.spawn(function()
                for _ = 1, 4 do
                    hl.OutlineTransparency = 0.7
                    task.wait(0.07)
                    hl.OutlineTransparency = 0
                    task.wait(0.07)
                end
            end)
        else
            lastClickTime = now
            -- Clique simples: efeito + abre/fecha painel
            task.spawn(function()
                cube.Transparency = 0.35
                cube.Color = Color3.fromRGB(5, 5, 5)
                hl.FillTransparency = 0.6
                hl.FillColor = Color3.fromRGB(0, 200, 255)
                task.wait(0.15)
                cube.Transparency = 0.78
                cube.Color = Color3.fromRGB(10, 10, 10)
                hl.FillTransparency = 1
            end)

            task.delay(DOUBLE_CLICK_TIME + 0.05, function()
                if lastClickTime == now then
                    if painelAberto then
                        fecharPainel()
                    else
                        abrirPainel()
                    end
                end
            end)
        end
    end)

    -- Loop principal
    local t = 0
    currentConnection = RunService.Heartbeat:Connect(function(dt)
        if not cube or not cube.Parent then return end
        if not hrp or not hrp.Parent then return end
        t += dt

        -- Cubo segue o personagem (igual ao original)
        local leftPos = hrp.CFrame * CFrame.new(-3, 0.5, 0)
        local floatY = math.sin(t * 2) * 0.5
        cube.CFrame = CFrame.new(leftPos.Position + Vector3.new(0, floatY, 0))
            * CFrame.Angles(t * 0.3, t * 0.8, 0)

        -- Auto captura
        if autoCapture then
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("Model") and obj ~= char and not isPlayerCharacter(obj) then
                    local npcHRP = obj:FindFirstChild("HumanoidRootPart")
                    local hum = obj:FindFirstChildOfClass("Humanoid")
                    if npcHRP and hum and hum.Health > 0 then
                        local dist = (npcHRP.Position - hrp.Position).Magnitude
                        if dist <= CAPTURE_RADIUS then
                            capturarNPC(obj)
                        end
                    end
                end
            end
        end
    end)
end

if LocalPlayer.Character then
    spawnCube(LocalPlayer.Character)
end
LocalPlayer.CharacterAdded:Connect(spawnCube)